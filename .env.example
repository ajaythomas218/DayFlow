# ==============================================================================
# DAYFLOW — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# 1. Supabase Client Credentials (Public - Safe for browser)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# 2. Supabase Server Admin Credentials (SECRET - NEVER EXPOSE TO CLIENT)
# Used only in server-side webhook/cron Route Handlers with secret-header verification
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here"

# 3. Google Calendar OAuth Credentials (Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# 4. Token & Payload Encryption Secrets (32-byte hex string)
# Generate with: openssl rand -hex 32
CALENDAR_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# 5. Background Cron & Webhook Verification Secrets
# Generate with: openssl rand -hex 24
CRON_SECRET="your-secure-cron-trigger-secret"
GOOGLE_WEBHOOK_SECRET="your-secure-webhook-channel-secret"

# 6. Web Push VAPID Keys (Free Browser Notifications)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-private-vapid-key"
VAPID_SUBJECT="mailto:support@yourdomain.com"

# 7. Application URL Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
